{
    "name": "hoaid/api-doc-packages",
    "description": "A beautiful RESTful API documentation package for Laravel using Scalar UI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "hoaid",
            "email": "hoaib@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/routing": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hoaid\\ApiDoc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hoaid\\ApiDoc\\ApiDocServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
